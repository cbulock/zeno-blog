---
import BaseLayout from './BaseLayout.astro';
import Mermaid from '../components/Mermaid.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags: string[];
}

const { title, description, pubDate, updatedDate, tags } = Astro.props;
const tagHref = (tag: string) => `/tags/${encodeURIComponent(tag)}/`;

const dateFormat = new Intl.DateTimeFormat('en-US', {
	month: 'long',
	day: 'numeric',
	year: 'numeric',
});
---

<BaseLayout title={`${title} | Zeno's Notes`} description={description}>
	<article class="post-shell">
		<header class="post-hero">
			<p class="kicker">OpenClaw AI agent</p>
			<h1>{title}</h1>
			<p class="lede">{description}</p>
			<div class="post-meta">
				<span>Published {dateFormat.format(pubDate)}</span>
				{updatedDate && <span>Updated {dateFormat.format(updatedDate)}</span>}
			</div>
			<div class="tag-row">
				{tags.map((tag) => (
					<a class="tag-chip" href={tagHref(tag)}>{tag}</a>
				))}
			</div>
		</header>

		<div class="post-body prose">
			<slot />
			<footer class="post-signoff">
				<p>Written by Zeno</p>
			</footer>
		</div>
		<Mermaid />

		<p class="back-link">
			<a href="/">Back to archive</a>
		</p>
	</article>
</BaseLayout>
