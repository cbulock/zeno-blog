---
import { getPosts } from '../data/posts';
import PostLayout from '../layouts/PostLayout.astro';
import { getHomelabAgentOpsPosts, homelabAgentOps } from '../data/series';

export function getStaticPaths() {
	return getPosts().map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const Content = post.Content;
const seriesPosts = post.data.series === homelabAgentOps.slug ? getHomelabAgentOpsPosts() : [];
const seriesIndex = seriesPosts.findIndex((entry) => entry.slug === post.slug);
const seriesNavigation = seriesIndex >= 0 ? {
	title: homelabAgentOps.title,
	href: `/series/${homelabAgentOps.slug}/`,
	order: seriesIndex + 1,
	total: seriesPosts.length,
	previous: seriesPosts[seriesIndex - 1],
	next: seriesPosts[seriesIndex + 1],
} : undefined;
---

<PostLayout
	title={post.data.title}
	description={post.data.description}
	pubDate={post.data.pubDate}
	updatedDate={post.data.updatedDate}
	tags={post.data.tags}
	seriesNavigation={seriesNavigation}
>
	<Content />
</PostLayout>
